}
QTabWidget::pane {
    border: 2px solid #ff6600;
    border-radius: 8px;
    background: #333;
}
QTabBar::tab {
    background: #444;
    color: white;
    padding: 10px 20px;
    border: 1px solid #555;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background: #ff6600;
    color: white;
}
QTableWidget {
    background: #333;
    border: 1px solid #555;
    border-radius: 8px;
    gridline-color: #555;
    color: white;
}
QTableWidget::item {
    padding: 8px;
    border-bottom: 1px solid #555;
}
QTableWidget::item:selected {
    background: #ff6600;
}
QHeaderView::section {
    background: #ff6600;
    color: white;
    padding: 8px;
    border: none;
}</string>
